APP_ENV=development
APP_NAME=Forma
APP_STORAGE_SECRET=change-me-before-deploy
HOST=0.0.0.0
PORT=8080

# Supabase: use the project URL and publishable key, never a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# AI provider: gemini | openai | openai_compatible | openrouter | groq | together | deepseek | ollama | deterministic
# Without a required key the app automatically falls back to deterministic demo responses.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_JUDGE_MODEL=gemini-3.5-flash-lite
AI_API_KEY=
AI_BASE_URL=

# Backward-compatible Gemini aliases. They are optional when AI_* is configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite
